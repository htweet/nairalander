{
  "name": "gisthall",
  "version": "0.1.0",
  "private": true,
  "description": "Gisthall: an original Nigerian-style community discussion forum.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/format.test.js tests/unit/forum.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
